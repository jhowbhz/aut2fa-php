{
    "name": "aut2fa/aut2fa-php",
    "description": "PHP client for the aut2fa two-factor authentication API",
    "type": "library",
    "license": "MIT",
    "keywords": ["aut2fa", "2fa", "otp", "authentication"],
    "homepage": "https://github.com/jhowbhz/aut2fa-php",
    "support": {
        "issues": "https://github.com/jhowbhz/aut2fa-php/issues",
        "source": "https://github.com/jhowbhz/aut2fa-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Aut2fa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aut2fa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/phpunit/phpunit/phpunit",
        "lint": [
            "@php -l src/Aut2fa.php",
            "@php -l src/ApiError.php",
            "@php -l src/InvalidResponseError.php",
            "@php -l src/NetworkError.php",
            "@php -l tests/SendContractTest.php",
            "@php -l tests/ApiErrorsTest.php",
            "@php -l tests/InputValidationTest.php",
            "@php -l tests/InvalidResponsesTest.php",
            "@php -l tests/TransportErrorsTest.php",
            "@php -l tests/Support/LocalHttpServer.php",
            "@php -l tests/Support/router.php"
        ]
    },
    "archive": {
        "exclude": [
            "/.github",
            "/.phpunit.cache",
            "/tests",
            "/vendor",
            "/dist",
            "/composer.lock",
            "/phpunit.xml",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
